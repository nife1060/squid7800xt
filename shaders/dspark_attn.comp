#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

// DSpark block attention: 8 bidirectional block rows + merge of attn_tile ctx partials.
// ctx attention (global Q4 over [p - cap, p) or local SWA BF16 over [p - 1024, p)) is computed
// beforehand by attn_tile.comp (SPEC_B = 8, last_off = -1, row_step = 0, rows_total = 8).
// Grid: (24, 8, 1), Local: 128 (2 Wave64 subgroups; each thread owns 2 dims).

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PC {
    uint64_t qkv_addr;       // [8, 5120] F32
    uint64_t ck_addr;        // unused (kept for PC layout stability)
    uint64_t cv_addr;
    uint64_t cks_addr;
    uint64_t cvs_addr;
    uint64_t split_buf_addr; // attn_tile partials (0 = no ctx)
    uint64_t out_h_addr;     // [8, 3072] F16
    uint64_t d_pos_addr;
    uint cap;
    uint window; // 1024 for local, 0 for global
    uint kv_fmt;
    uint mode;   // must be 1
} pc;

const uint QKV_STRIDE = Q_DIM + 2u * KV_DIM;
const uint DS_ROWS = 8u;

shared float s_m[2];
shared float s_d[2];
shared float s_acc[2][HEAD_DIM];

void main() {
    uint tid = gl_LocalInvocationID.x;
    int p = I32Buf(pc.d_pos_addr).data[0];

    uint h = gl_WorkGroupID.x;
    uint r = gl_WorkGroupID.y;
    uint sg = tid >> 6u;
    uint lane = tid & 63u;
    uint kvh = h / GQA_RATIO;
    uint d2 = lane * 2u;

    F32Buf qp = F32Buf(pc.qkv_addr + uint64_t(r * QKV_STRIDE + h * HEAD_DIM) * 4ul);
    vec2 qv = vec2(qp.data[d2], qp.data[d2 + 1u]);

    float acc0 = 0.0, acc1 = 0.0;
    float m_val = -1e30, d_val = 0.0;

    // Bidirectional 8 block rows (sg 0: rows 0,2,4,6; sg 1: rows 1,3,5,7)
    for (uint br = sg; br < DS_ROWS; br += 2u) {
        F32Buf bk = F32Buf(pc.qkv_addr + uint64_t(br * QKV_STRIDE + Q_DIM + kvh * HEAD_DIM + d2) * 4ul);
        F32Buf bv = F32Buf(pc.qkv_addr + uint64_t(br * QKV_STRIDE + Q_DIM + KV_DIM + kvh * HEAD_DIM + d2) * 4ul);
        vec2 kv = vec2(bk.data[0], bk.data[1]);
        vec2 vv = vec2(bv.data[0], bv.data[1]);
        float score = subgroupAdd(fma(qv.x, kv.x, qv.y * kv.y)) * INV_SQRT_HEAD_DIM;
        float mn = max(m_val, score);
        float a = exp(m_val - mn);
        float pw = exp(score - mn);
        d_val = d_val * a + pw;
        acc0 = fma(pw, vv.x, acc0 * a);
        acc1 = fma(pw, vv.y, acc1 * a);
        m_val = mn;
    }

    if (lane == 0u) { s_m[sg] = m_val; s_d[sg] = d_val; }
    s_acc[sg][d2] = acc0;
    s_acc[sg][d2 + 1u] = acc1;
    barrier();

    uint span = (pc.window > 0u) ? pc.window : pc.cap;
    uvec2 lay = attn_split_layout(max(0, p - int(span)), p, ATTN_SPLIT_MAX);
    if (pc.split_buf_addr == 0ul) lay.y = 0u;

    uint E = NUM_HEADS * DS_ROWS * ATTN_SPLIT_MAX;
    uint base = (h * DS_ROWS + r) * ATTN_SPLIT_MAX;
    F32Buf s_m_in = F32Buf(pc.split_buf_addr);
    F32Buf s_d_in = F32Buf(pc.split_buf_addr + uint64_t(E) * 4ul);
    F32Buf s_o_in = F32Buf(pc.split_buf_addr + uint64_t(2u * E) * 4ul);

    float g_m = max(s_m[0], s_m[1]);
    for (uint s = 0u; s < lay.y; ++s) {
        if (s_d_in.data[base + s] > 0.0) g_m = max(g_m, s_m_in.data[base + s]);
    }
    float g_d = 0.0, g_o = 0.0;
    for (uint w = 0u; w < 2u; ++w) {
        if (s_d[w] > 0.0) {
            float sc = exp(s_m[w] - g_m);
            g_d += s_d[w] * sc;
            g_o += s_acc[w][tid] * sc;
        }
    }
    for (uint s = 0u; s < lay.y; ++s) {
        float sd = s_d_in.data[base + s];
        if (sd > 0.0) {
            float sc = exp(s_m_in.data[base + s] - g_m);
            g_d += sd * sc;
            g_o += s_o_in.data[(base + s) * HEAD_DIM + tid] * sc;
        }
    }
    F16Buf oh = F16Buf(pc.out_h_addr);
    oh.data[r * Q_DIM + h * HEAD_DIM + tid] = float16_t(g_o / g_d);
}
