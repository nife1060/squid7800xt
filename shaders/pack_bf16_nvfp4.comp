#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "nvfp4_scale_search.glsl"

// Multi-mode BF16 packer:
// mode == 0: compute global tensor amax into dst_amax_u32 (atomicMax of floatBitsToUint(abs(v)))
// mode == 1: quantize [N, K] BF16 -> NVFP4 (dst_w [N, K/2] + dst_s [N, K/16]) using global_scale = amax / (448 * 6)
// mode == 2: quantize [N, K] BF16 -> per-row FP8 E4M3 (dst_w [N, K] U8 + dst_s [N] F32 pre-multiplied by 64.0
//            so runtime LUT decode_e4m3(c)/64 stays in [-7, +7] with zero FP16 overflow risk);
//            Grid = (N, 1, 1), total_elems = K.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PC {
    uint64_t src_addr;
    uint64_t dst_w_addr;
    uint64_t dst_s_addr;
    uint64_t amax_addr; // u32 atomic max output (mode 0) or input (mode 1)
    uint total_elems;   // N * K (mode 0), total_blocks16 (mode 1), or K (mode 2)
    uint mode;
} pc;

shared float s_max[8];
shared float s_row_inv;

void main() {
    uint tid = gl_LocalInvocationID.x;
    if (pc.mode == 0u) {
        U16Buf src = U16Buf(pc.src_addr);
        uint gid = gl_GlobalInvocationID.x;
        uint stride = gl_NumWorkGroups.x * 256u;
        float lmax = 0.0;
        for (uint i = gid; i < pc.total_elems; i += stride) {
            lmax = max(lmax, abs(bf16_to_f32(src.data[i])));
        }
        float sg_max = subgroupMax(lmax);
        if (subgroupElect()) {
            s_max[gl_SubgroupID] = sg_max;
        }
        barrier();
        if (tid == 0u) {
            float bmax = 0.0;
            for (uint s = 0u; s < gl_NumSubgroups; ++s) {
                bmax = max(bmax, s_max[s]);
            }
            U32Buf amax_buf = U32Buf(pc.amax_addr);
            atomicMax(amax_buf.data[0], floatBitsToUint(bmax));
        }
        return;
    }

    if (pc.mode == 2u) {
        // Per-row BF16 -> FP8 E4M3 (1 WG per row, cols = pc.total_elems)
        uint row = gl_WorkGroupID.x;
        uint K = pc.total_elems;
        U16Buf src = U16Buf(pc.src_addr + uint64_t(row) * uint64_t(K) * 2ul);
        float lmax = 0.0;
        for (uint k = tid; k < K; k += 256u) {
            lmax = max(lmax, abs(bf16_to_f32(src.data[k])));
        }
        float sg_max = subgroupMax(lmax);
        if (subgroupElect()) s_max[gl_SubgroupID] = sg_max;
        barrier();
        if (tid == 0u) {
            float rmax = 0.0;
            for (uint s = 0u; s < gl_NumSubgroups; ++s) rmax = max(rmax, s_max[s]);
            float raw_sc = max(rmax / 448.0, 1e-12);
            // Store raw_sc * 64.0; runtime LUT scales E4M3 by 1/64 into [-7, +7] to prevent FP16 overflow.
            F32Buf(pc.dst_s_addr).data[row] = raw_sc * 64.0;
            s_row_inv = 1.0 / raw_sc;
        }
        barrier();
        float inv_sc = s_row_inv;
        U8Buf dst_w = U8Buf(pc.dst_w_addr + uint64_t(row) * uint64_t(K));
        for (uint k = tid; k < K; k += 256u) {
            dst_w.data[k] = uint8_t(encode_e4m3(bf16_to_f32(src.data[k]) * inv_sc));
        }
        return;
    }

    // mode == 1: quantize 16-element blocks to NVFP4
    uint bidx = gl_GlobalInvocationID.x;
    if (bidx >= pc.total_elems) return;

    U32Buf amax_buf = U32Buf(pc.amax_addr);
    float amax = uintBitsToFloat(amax_buf.data[0]);
    float global_scale = max(amax / (448.0 * 6.0), 1e-12);

    U16Buf src_blk = U16Buf(pc.src_addr + uint64_t(bidx) * 32ul);
    float vals[16];
    float bmax = 0.0;
    for (uint i = 0u; i < 16u; ++i) {
        vals[i] = bf16_to_f32(src_blk.data[i]);
        bmax = max(bmax, abs(vals[i]));
    }
    uint s_code = nvfp4_search_block_scale(vals, bmax, global_scale);
    U8Buf dst_s = U8Buf(pc.dst_s_addr + uint64_t(bidx));
    dst_s.data[0] = uint8_t(s_code);

    float s_eff = decode_e4m3(s_code) * global_scale;
    float inv_s = (s_eff > 1e-30) ? (1.0 / s_eff) : 0.0;

    U8Buf dst_w = U8Buf(pc.dst_w_addr + uint64_t(bidx) * 8ul);
    for (uint i = 0u; i < 8u; ++i) {
        uint q0 = quantize_e2m1(vals[2u * i] * inv_s);
        uint q1 = quantize_e2m1(vals[2u * i + 1u] * inv_s);
        dst_w.data[i] = uint8_t(q0 | (q1 << 4u));
    }
}
