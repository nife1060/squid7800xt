#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

// Two-mode BF16 -> NVFP4 packer:
// mode == 0: compute global tensor amax into dst_amax_u32 (atomicMax of floatBitsToUint(abs(v)))
// mode == 1: quantize [N, K] BF16 -> NVFP4 (dst_w [N, K/2] + dst_s [N, K/16]) using global_scale = amax / (448 * 6)

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PC {
    uint64_t src_addr;
    uint64_t dst_w_addr;
    uint64_t dst_s_addr;
    uint64_t amax_addr; // u32 atomic max output (mode 0) or input (mode 1)
    uint total_elems;   // N * K (mode 0) or total_blocks16 = N * (K/16) (mode 1)
    uint mode;
} pc;

shared float s_max[8];

void main() {
    uint tid = gl_LocalInvocationID.x;
    if (pc.mode == 0u) {
        U16Buf src = U16Buf(pc.src_addr);
        uint gid = gl_GlobalInvocationID.x;
        uint stride = gl_NumWorkGroups.x * 256u;
        float lmax = 0.0;
        for (uint i = gid; i < pc.total_elems; i += stride) {
            lmax = max(lmax, abs(bf16_to_f32(src.data[i])));
        }
        float sg_max = subgroupMax(lmax);
        if (subgroupElect()) {
            s_max[gl_SubgroupID] = sg_max;
        }
        barrier();
        if (tid == 0u) {
            float bmax = 0.0;
            for (uint s = 0u; s < gl_NumSubgroups; ++s) {
                bmax = max(bmax, s_max[s]);
            }
            U32Buf amax_buf = U32Buf(pc.amax_addr);
            atomicMax(amax_buf.data[0], floatBitsToUint(bmax));
        }
        return;
    }

    // mode == 1: quantize 16-element blocks
    uint bidx = gl_GlobalInvocationID.x;
    if (bidx >= pc.total_elems) return;

    U32Buf amax_buf = U32Buf(pc.amax_addr);
    float amax = uintBitsToFloat(amax_buf.data[0]);
    float global_scale = max(amax / (448.0 * 6.0), 1e-12);

    U16Buf src_blk = U16Buf(pc.src_addr + uint64_t(bidx) * 32ul);
    float vals[16];
    float bmax = 0.0;
    for (uint i = 0u; i < 16u; ++i) {
        vals[i] = bf16_to_f32(src_blk.data[i]);
        bmax = max(bmax, abs(vals[i]));
    }
    uint s_code = encode_e4m3(min(bmax / (6.0 * global_scale), 448.0));
    U8Buf dst_s = U8Buf(pc.dst_s_addr + uint64_t(bidx));
    dst_s.data[0] = uint8_t(s_code);

    float s_eff = decode_e4m3(s_code) * global_scale;
    float inv_s = (s_eff > 1e-30) ? (1.0 / s_eff) : 0.0;

    U8Buf dst_w = U8Buf(pc.dst_w_addr + uint64_t(bidx) * 8ul);
    for (uint i = 0u; i < 8u; ++i) {
        uint q0 = quantize_e2m1(vals[2u * i] * inv_s);
        uint q1 = quantize_e2m1(vals[2u * i + 1u] * inv_s);
        dst_w.data[i] = uint8_t(q0 | (q1 << 4u));
    }
}
