#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

// Zero-Atomic Deterministic Wave64 LDS-LUT256 NVFP4 MoE Down (w2: [128, 2304, 1152])
// Specialized on SPEC_B (1, 2, 4, 8) + 16-byte uvec4 act loads!
// Grid: (HIDDEN / 16 = 144, 1, 1), Local: 256 threads (Wave64).

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(constant_id = 0) const uint SPEC_B = 1u;

layout(push_constant) uniform PC {
    uint64_t w_addr;        // [128, 2304, 576] U8
    uint64_t s_addr;        // [128, 2304, 72]  U8
    uint64_t exp_sc_addr;   // [128] F32
    uint64_t act_h_addr;    // [B, TOP_K, 1152] F16
    uint64_t groups_addr;   // ExpertGroups
    uint64_t out_down_addr; // [B, 2304] F32
    uint B;
    uint n_lo;              // experts [0, n_lo) live at w_addr/s_addr (VRAM)
    uint64_t w_hi_addr;     // experts [n_lo, 128) in pinned DDR5, pre-biased by -n_lo * stride
    uint64_t s_hi_addr;
} pc;

shared f16vec2 s_e2m1x2[256];
shared float s_e4m3[256];

float dot16_h2(
    f16vec2 wh0, f16vec2 wh1, f16vec2 wh2, f16vec2 wh3,
    f16vec2 wh4, f16vec2 wh5, f16vec2 wh6, f16vec2 wh7,
    F16Vec2Buf act_buf, uint xo
) {
    f16vec2 p0 = wh0 * act_buf.data[xo + 0u];
    f16vec2 p1 = wh1 * act_buf.data[xo + 1u];
    p0 = fma(wh2, act_buf.data[xo + 2u], p0);
    p1 = fma(wh3, act_buf.data[xo + 3u], p1);
    p0 = fma(wh4, act_buf.data[xo + 4u], p0);
    p1 = fma(wh5, act_buf.data[xo + 5u], p1);
    p0 = fma(wh6, act_buf.data[xo + 6u], p0);
    p1 = fma(wh7, act_buf.data[xo + 7u], p1);
    f16vec2 s2 = p0 + p1;
    return float(s2.x) + float(s2.y);
}

void store_out(F32Buf out_d, uint b, uint row, uint lane16, float v) {
    v += subgroupShuffleXor(v, 8u);
    v += subgroupShuffleXor(v, 4u);
    v += subgroupShuffleXor(v, 2u);
    v += subgroupShuffleXor(v, 1u);
    if (lane16 == 0u) out_d.data[b * HIDDEN + row] = v;
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    s_e2m1x2[tid] = f16vec2(E2M1_LUT[tid & 0xFu], E2M1_LUT[(tid >> 4u) & 0xFu]);
    s_e4m3[tid] = decode_e4m3(tid);
    barrier();

    uint row_in_wg = tid >> 4u;
    uint lane16 = tid & 15u;
    uint row = gl_WorkGroupID.x * 16u + row_in_wg;
    if (row >= HIDDEN) return;

    U32Buf g_u32 = U32Buf(pc.groups_addr);
    F32Buf g_f32 = F32Buf(pc.groups_addr);
    F32Buf exp_sc = F32Buf(pc.exp_sc_addr);
    F16Vec2Buf act_buf = F16Vec2Buf(pc.act_h_addr);

    uint n_uniq = g_u32.data[0u];
    const uint N_BLK16 = INTERMEDIATE >> 4u; // 72
    const uint K_H2 = INTERMEDIATE >> 1u;    // 576

    float t0 = 0.0, t1 = 0.0, t2 = 0.0, t3 = 0.0;
    float t4 = 0.0, t5 = 0.0, t6 = 0.0, t7 = 0.0;

    for (uint u = 0u; u < n_uniq; ++u) {
        uint e = g_u32.data[1u + u];
        uint tmask = g_u32.data[65u + u];
        float es = exp_sc.data[e];

        uint64_t exp_row = uint64_t(e) * uint64_t(HIDDEN) + uint64_t(row);
        bool lo_tier = e < pc.n_lo;
        Uvec2Buf w_buf = Uvec2Buf((lo_tier ? pc.w_addr : pc.w_hi_addr) + exp_row * uint64_t(N_BLK16) * 8ul);
        U8Buf s_buf = U8Buf((lo_tier ? pc.s_addr : pc.s_hi_addr) + exp_row * uint64_t(N_BLK16));

        uint s0 = 0u, s1 = 0u, s2 = 0u, s3 = 0u, s4 = 0u, s5 = 0u, s6 = 0u, s7 = 0u;
        if (SPEC_B == 1u) {
            s0 = g_u32.data[129u + u * 8u + 0u] * K_H2;
        } else {
            if ((tmask & 1u) != 0u) s0 = (0u * TOP_K + g_u32.data[129u + u * 8u + 0u]) * K_H2;
            if (SPEC_B >= 2u && (tmask & 2u) != 0u) s1 = (1u * TOP_K + g_u32.data[129u + u * 8u + 1u]) * K_H2;
            if (SPEC_B >= 4u && (tmask & 4u) != 0u) s2 = (2u * TOP_K + g_u32.data[129u + u * 8u + 2u]) * K_H2;
            if (SPEC_B >= 4u && (tmask & 8u) != 0u) s3 = (3u * TOP_K + g_u32.data[129u + u * 8u + 3u]) * K_H2;
            if (SPEC_B >= 8u && (tmask & 16u) != 0u) s4 = (4u * TOP_K + g_u32.data[129u + u * 8u + 4u]) * K_H2;
            if (SPEC_B >= 8u && (tmask & 32u) != 0u) s5 = (5u * TOP_K + g_u32.data[129u + u * 8u + 5u]) * K_H2;
            if (SPEC_B >= 8u && (tmask & 64u) != 0u) s6 = (6u * TOP_K + g_u32.data[129u + u * 8u + 6u]) * K_H2;
            if (SPEC_B >= 8u && (tmask & 128u) != 0u) s7 = (7u * TOP_K + g_u32.data[129u + u * 8u + 7u]) * K_H2;
        }

        float a0 = 0.0, a1 = 0.0, a2 = 0.0, a3 = 0.0;
        float a4 = 0.0, a5 = 0.0, a6 = 0.0, a7 = 0.0;

        for (uint blk = lane16; blk < N_BLK16; blk += 16u) {
            uvec2 w8 = w_buf.data[blk];
            float sc = s_e4m3[uint(s_buf.data[blk])];

            f16vec2 wh0 = s_e2m1x2[w8.x & 0xFFu];
            f16vec2 wh1 = s_e2m1x2[(w8.x >> 8u) & 0xFFu];
            f16vec2 wh2 = s_e2m1x2[(w8.x >> 16u) & 0xFFu];
            f16vec2 wh3 = s_e2m1x2[(w8.x >> 24u) & 0xFFu];
            f16vec2 wh4 = s_e2m1x2[w8.y & 0xFFu];
            f16vec2 wh5 = s_e2m1x2[(w8.y >> 8u) & 0xFFu];
            f16vec2 wh6 = s_e2m1x2[(w8.y >> 16u) & 0xFFu];
            f16vec2 wh7 = s_e2m1x2[(w8.y >> 24u) & 0xFFu];

            uint xb = blk * 8u;
            if (SPEC_B == 1u) {
                a0 = fma(dot16_h2(wh0, wh1, wh2, wh3, wh4, wh5, wh6, wh7, act_buf, s0 + xb), sc, a0);
            } else {
                if ((tmask & 1u) != 0u) a0 = fma(dot16_h2(wh0, wh1, wh2, wh3, wh4, wh5, wh6, wh7, act_buf, s0 + xb), sc, a0);
                if (SPEC_B >= 2u && (tmask & 2u) != 0u) a1 = fma(dot16_h2(wh0, wh1, wh2, wh3, wh4, wh5, wh6, wh7, act_buf, s1 + xb), sc, a1);
                if (SPEC_B >= 4u && (tmask & 4u) != 0u) a2 = fma(dot16_h2(wh0, wh1, wh2, wh3, wh4, wh5, wh6, wh7, act_buf, s2 + xb), sc, a2);
                if (SPEC_B >= 4u && (tmask & 8u) != 0u) a3 = fma(dot16_h2(wh0, wh1, wh2, wh3, wh4, wh5, wh6, wh7, act_buf, s3 + xb), sc, a3);
                if (SPEC_B >= 8u && (tmask & 16u) != 0u) a4 = fma(dot16_h2(wh0, wh1, wh2, wh3, wh4, wh5, wh6, wh7, act_buf, s4 + xb), sc, a4);
                if (SPEC_B >= 8u && (tmask & 32u) != 0u) a5 = fma(dot16_h2(wh0, wh1, wh2, wh3, wh4, wh5, wh6, wh7, act_buf, s5 + xb), sc, a5);
                if (SPEC_B >= 8u && (tmask & 64u) != 0u) a6 = fma(dot16_h2(wh0, wh1, wh2, wh3, wh4, wh5, wh6, wh7, act_buf, s6 + xb), sc, a6);
                if (SPEC_B >= 8u && (tmask & 128u) != 0u) a7 = fma(dot16_h2(wh0, wh1, wh2, wh3, wh4, wh5, wh6, wh7, act_buf, s7 + xb), sc, a7);
            }
        }

        if (SPEC_B == 1u) {
            t0 = fma(a0, es * g_f32.data[641u + u * 8u + 0u], t0);
        } else {
            if ((tmask & 1u) != 0u) t0 = fma(a0, es * g_f32.data[641u + u * 8u + 0u], t0);
            if (SPEC_B >= 2u && (tmask & 2u) != 0u) t1 = fma(a1, es * g_f32.data[641u + u * 8u + 1u], t1);
            if (SPEC_B >= 4u && (tmask & 4u) != 0u) t2 = fma(a2, es * g_f32.data[641u + u * 8u + 2u], t2);
            if (SPEC_B >= 4u && (tmask & 8u) != 0u) t3 = fma(a3, es * g_f32.data[641u + u * 8u + 3u], t3);
            if (SPEC_B >= 8u && (tmask & 16u) != 0u) t4 = fma(a4, es * g_f32.data[641u + u * 8u + 4u], t4);
            if (SPEC_B >= 8u && (tmask & 32u) != 0u) t5 = fma(a5, es * g_f32.data[641u + u * 8u + 5u], t5);
            if (SPEC_B >= 8u && (tmask & 64u) != 0u) t6 = fma(a6, es * g_f32.data[641u + u * 8u + 6u], t6);
            if (SPEC_B >= 8u && (tmask & 128u) != 0u) t7 = fma(a7, es * g_f32.data[641u + u * 8u + 7u], t7);
        }
    }

    F32Buf out_d = F32Buf(pc.out_down_addr);
    store_out(out_d, 0u, row, lane16, t0);
    if (SPEC_B >= 2u) store_out(out_d, 1u, row, lane16, t1);
    if (SPEC_B >= 4u) {
        store_out(out_d, 2u, row, lane16, t2);
        store_out(out_d, 3u, row, lane16, t3);
    }
    if (SPEC_B >= 8u) {
        store_out(out_d, 4u, row, lane16, t4);
        store_out(out_d, 5u, row, lane16, t5);
        store_out(out_d, 6u, row, lane16, t6);
        store_out(out_d, 7u, row, lane16, t7);
    }
}
